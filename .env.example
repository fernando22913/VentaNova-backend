# Backend — copy to .env and adjust
NODE_ENV=development
# Local default; in production Render injects PORT automatically (do not set it).
PORT=3000
# Local DATABASE_URL points at the docker-compose PostgreSQL below. In
# production Render injects its own PostgreSQL connection string instead.
DATABASE_URL=postgresql://bytemarket:change_me@localhost:5432/bytemarket
CORS_ORIGIN=http://localhost:4200
JWT_SECRET=change_me_generate_a_long_random_string

# Initial admin account used by the seed (db:seed). These are LOCAL-DEVELOPMENT
# placeholders only — never commit real credentials. In production supply both
# through Render environment variables/secrets instead of this file.
ADMIN_EMAIL=admin@bytemarket.dev
ADMIN_PASSWORD=change_me_local_admin_password

# Token lifetimes (compact durations: s/m/h/d). Access tokens are short-lived
# JWTs; refresh tokens are opaque, hashed at rest and rotated on every use.
ACCESS_TOKEN_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=7d

# Structured-log verbosity (fatal|error|warn|info|debug|trace). Tests always
# run silent regardless of this value.
LOG_LEVEL=info

# Integration tests only (backend/tests). This database is auto-created and
# migrated by the test helper; it is not needed to run the API. Defaults to
# bytemarket_test on the local PostgreSQL instance.
TEST_DATABASE_URL=postgresql://bytemarket:change_me@localhost:5432/bytemarket_test

# Docker Compose — local PostgreSQL (docker-compose.yml reads these from .env).
# Only needed for local development; ignored by the app's config validation.
POSTGRES_USER=bytemarket
POSTGRES_PASSWORD=change_me
POSTGRES_DB=bytemarket
POSTGRES_PORT=5432
